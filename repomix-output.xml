<file path="src/app/shared/components/header/header.component.html">
<header class="header">
  <div class="logo">
    <span class="logo-egy">Egy</span><span class="logo-guide">Guide</span>
  </div>

  <nav class="nav">
    <a routerLink="/" routerLinkActive="active" [routerLinkActiveOptions]="{exact: true}">{{ 'nav.home' | translate }}</a>
    <a routerLink="/chat" routerLinkActive="active">{{ 'nav.chat' | translate }}</a>
    <a routerLink="/history" routerLinkActive="active">{{ 'nav.history' | translate }}</a>
    <a routerLink="/about" routerLinkActive="active">{{ 'nav.about' | translate }}</a>
  </nav>

  <!-- Language Dropdown -->
  <div class="lang-switcher">
    <button
      class="lang-selected"
      (click)="toggleDropdown(); $event.stopPropagation()"
      [attr.aria-expanded]="isDropdownOpen()"
    >
      <span class="lang-label">{{ 'lang.label' | translate }}</span>
      <svg
        class="lang-arrow"
        [class.open]="isDropdownOpen()"
        width="12" height="12" viewBox="0 0 12 12" fill="none"
      >
        <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.8"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    @if (isDropdownOpen()) {
      <div class="lang-dropdown" (click)="$event.stopPropagation()">
        @for (lang of languages; track lang.code) {
          <button
            class="lang-option"
            [class.active]="currentLang() === lang.code"
            (click)="selectLanguage(lang.code)"
          >
            <span class="option-label">{{ lang.label }}</span>
            @if (currentLang() === lang.code) {
              <svg class="check-icon" width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M2 7L5.5 10.5L12 3.5" stroke="#d4af37" stroke-width="1.8"
                      stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            }
          </button>
        }
      </div>
    }
  </div>
</header>
</file>

<file path="src/app/shared/components/header/header.component.scss">
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem 3rem;
  background-color: #1a1a1a;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  font-family: 'Cormorant Garamond', 'Georgia', 'Palatino', serif;

  .logo {
    font-size: 2rem;
    font-weight: 300;

    .logo-egy  { color: #fff; }
    .logo-guide { color: #d4af37; }
  }

  .nav {
    display: flex;
    gap: 2.5rem;

    a {
      color: rgba(255, 255, 255, 0.7);
      text-decoration: none;
      font-size: 1.4rem;
      transition: color 0.3s;

      &:hover,
      &.active { color: #d4af37; }
    }
  }

  // ── Language Dropdown ──────────────────────────────────────────
  .lang-switcher {
    position: relative;

    // Trigger: "Choose Language ▾"
    .lang-selected {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: transparent;
      border: 1px solid rgba(212, 175, 55, 0.45);
      border-radius: 8px;
      color: #d4af37;
      padding: 0.4rem 0.85rem;
      cursor: pointer;
      font-family: 'Cormorant Garamond', 'Georgia', 'Palatino', serif;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      white-space: nowrap;
      transition: background 0.25s, border-color 0.25s;

      &:hover {
        background: rgba(212, 175, 55, 0.1);
        border-color: #d4af37;
      }

      .lang-label {
        font-size: 0.95rem;
      }

      // Rotating chevron
      .lang-arrow {
        color: rgba(212, 175, 55, 0.75);
        transition: transform 0.25s ease;
        flex-shrink: 0;

        &.open { transform: rotate(180deg); }
      }
    }

    // Dropdown panel
    .lang-dropdown {
      position: absolute;
      top: calc(100% + 0.5rem);
      right: 0;
      min-width: 170px;
      background: #1c1c1c;
      border: 1px solid rgba(212, 175, 55, 0.3);
      border-radius: 10px;
      overflow: hidden;
      z-index: 1000;
      box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.6),
        0 0 0 1px rgba(212, 175, 55, 0.06);
      animation: dropdownIn 0.18s ease;

      .lang-option {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        width: 100%;
        background: transparent;
        border: none;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        color: rgba(255, 255, 255, 0.72);
        padding: 0.7rem 1rem;
        cursor: pointer;
        font-family: 'Cormorant Garamond', 'Georgia', 'Palatino', serif;
        font-size: 1.05rem;
        text-align: left;
        transition: background 0.2s, color 0.2s;

        &:last-child { border-bottom: none; }

        .option-flag {
          font-size: 1.25rem;  // Larger flag emoji
          line-height: 1;
          flex-shrink: 0;
        }

        .option-label { flex: 1; }

        .check-icon {
          flex-shrink: 0;
          opacity: 0.9;
        }

        &:hover {
          background: rgba(212, 175, 55, 0.1);
          color: #d4af37;
        }

        &.active {
          color: #d4af37;
          background: rgba(212, 175, 55, 0.12);
          font-weight: 600;
        }
      }
    }
  }
}

@keyframes dropdownIn {
  from { opacity: 0; transform: translateY(-6px); }
  to   { opacity: 1; transform: translateY(0); }
}

@media (max-width: 768px) {
  .header {
    padding: 1rem 1.5rem;

    .nav {
      gap: 1.5rem;
      a { font-size: 1.1rem; }
    }
  }
}
</file>

