  padding: 0;
  box-sizing: border-box;
}

html, body {
  height: 100%;
  font-family: 'Cormorant Garamond', 'Georgia', 'Palatino', serif;
  background-color: #0f0f0f;
  color: white;
}

body {
  margin: 0;
  overflow-x: hidden;
}

/* Scrollbar Styling */
::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: #1a1a1a;
}

::-webkit-scrollbar-thumb {
  background: rgba(212, 175, 55, 0.5);
  border-radius: 5px;
}

::-webkit-scrollbar-thumb:hover {
  background: #d4af37;
}

/* Selection Color */
::selection {
  background-color: rgba(212, 175, 55, 0.3);
  color: white;
}

/* Smooth scrolling */
html {
  scroll-behavior: smooth;
}
