    color: #d4af37;
    border: 2px solid #d4af37;
    padding: 1rem 3rem;
    font-size: 1.2rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s;
    font-weight: 500;
    min-width: 200px; 
