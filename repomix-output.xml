  .capture-btn {
    background: #d4af37;
    color: black;
    padding: 0.8rem 2rem;
    border-radius: 25px;
  }

  .cancel-btn {
    background: transparent;
    border: 1px solid white;
    color: white;
    padding: 0.8rem 2rem;
    border-radius: 25px;
  }
}
